{
  "name": "rahe-family-research",
  "version": "13.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": ">=11"
  },
  "dependencies": {
    "@netlify/blobs": "11.0.3",
    "@netlify/functions": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "netlify-cli": "27.5.2"
  },
  "scripts": {
    "upgrade-corpus": "node scripts/upgrade-corpus.mjs && node scripts/canonical-integrity.mjs",
    "canonical-integrity": "node scripts/canonical-integrity.mjs",
    "build-model": "node scripts/build/pipeline.mjs --no-upgrade",
    "test": "node scripts/test/run.mjs",
    "test:e2e": "playwright test",
    "architecture:audit": "node scripts/architecture-audit.mjs",
    "build": "node scripts/build/pipeline.mjs --site",
    "dev": "netlify dev"
  }
